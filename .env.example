# Copy to .env and fill in.

# Session encryption key for nuxt-auth-utils (min. 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Postgres connection string (Neon in production).
# Leave empty for local development to use the built-in PGlite database.
DATABASE_URL=

# Strava OAuth (Phase 6) — obtain after Strava API approval.
NUXT_STRAVA_CLIENT_ID=
NUXT_STRAVA_CLIENT_SECRET=
NUXT_STRAVA_WEBHOOK_VERIFY_TOKEN=
