# Copy to .env and fill in.

# --- Core -------------------------------------------------------------------

# Session encryption key for nuxt-auth-utils (min. 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Postgres connection string (Neon in production).
# Leave empty for local development to use the built-in PGlite database.
DATABASE_URL=

# --- Admin gate -------------------------------------------------------------

# Password that unlocks operator-only features (the Strava connection).
# Must be at least 12 characters; an unset value keeps the gate permanently shut.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
NUXT_ADMIN_UNLOCK_PASSWORD=

# --- Strava -----------------------------------------------------------------

# From https://www.strava.com/settings/api — create an application there.
# Set the callback domain to "localhost" for development, your host in production.
NUXT_STRAVA_CLIENT_ID=
NUXT_STRAVA_CLIENT_SECRET=

# Encrypts the stored Strava tokens at rest (min. 32 chars).
# Changing it makes existing connections unreadable — they must reconnect.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_TOKEN_ENCRYPTION_KEY=

# Only needed once webhooks are set up (not required for manual sync).
NUXT_STRAVA_WEBHOOK_VERIFY_TOKEN=
